<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Memory App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# --- ここからヘッダーを追加 --- %>
    <header style="background-color: #f0f0f0; padding: 10px; margin-bottom: 20px;">
      
      <nav style="margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px dashed #ccc;">
        <%= link_to "📝 思い出一覧", posts_path, style: "margin-right: 15px; font-weight: bold; text-decoration: none;" %>
        <%= link_to "📸 フォトアルバム", photos_path, style: "margin-right: 15px; font-weight: bold; text-decoration: none;" %>
      </nav>
      <% if current_user %>
        <%# ログインしている時：ニックネームとログアウトボタンを表示 %>
        <span style="font-weight: bold; color: <%= current_user.theme_color %>;">
          <%= current_user.nickname %>さん、こんにちは！
        </span>
        <%# button_toを使うと、安全なログアウト処理(DELETE)を簡単に作れます %>
        <%= button_to 'ログアウト', logout_path, method: :delete, style: "display: inline-block; margin-left: 10px;" %>
      <% else %>
        <%# ログインしていない時：登録とログインへのリンクを表示 %>
        <%= link_to '新規登録', signup_path %> |
        <%= link_to 'ログイン', login_path %>
      <% end %>
    </header>
    <%# --- ヘッダーここまで --- %>

    <%# 成功・失敗のメッセージを全画面共通で表示させる設定 %>
    <% if flash[:notice] %>
      <p style="color: green;"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p style="color: red;"><%= flash[:alert] %></p>
    <% end %>

    <%# ここに各画面（新規登録やログイン画面など）の中身が差し込まれます %>
    <%= yield %>
  </body>
</html>
