<div class="auth-wrapper">
  <div class="auth-card">
    
    <div class="auth-left">
      <%= image_tag "welcome_illustration.jpg", class: "auth-illustration" %>
      <h3 style="color: #555;">コミュニティへようこそ</h3>
    </div>

    <div class="auth-right">
      
      <div class="auth-toggle-container">
        <div class="auth-toggle">
          <%= link_to "新規登録", signup_path %>
          <%= link_to "ログイン", login_path, class: "active" %>
        </div>
      </div>

      <%= form_with url: login_path, local: true do |f| %>
        
        <div class="auth-form-group">
          <%= f.label :email, "ユーザーID / メールアドレス", class: "auth-label" %>
          <%= f.email_field :email, class: "auth-input", placeholder: "IDまたはメールアドレスを入力" %>
        </div>

        <div class="auth-form-group">
          <%= f.label :password, "パスワード", class: "auth-label" %>
          <%= f.password_field :password, class: "auth-input", placeholder: "パスワード" %>
        </div>

        <%= f.submit "ログイン", class: "auth-submit-btn" %>
      <% end %>
      </div>
  </div>
</div>