<h1>写真の情報を編集する</h1>

<% if @photo.errors.any? %>
  <div style="color: red; border: 1px solid red; padding: 10px; margin-bottom: 20px; border-radius: 5px;">
    <b>保存できませんでした：</b>
    <ul>
      <% @photo.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @photo, local: true do |form| %>
  
  <%# もしすでに画像があれば、今の画像を小さく表示しておく親切設計！ %>
  <% if @photo.image.attached? %>
    <div style="margin-bottom: 10px;">
      <p>現在の写真：</p>
      <%= image_tag @photo.image, style: "width: 200px; border-radius: 4px;" %>
    </div>
  <% end %>

  <div>
    <%= form.label :event_date, "撮影日" %><br>
    <%= form.date_field :event_date %>
  </div>
  <br>

  <div>
    <%= form.label :content, "写真の説明（キャプション）" %><br>
    <%= form.text_area :content, size: "40x3" %>
  </div>
  <br>

  <div>
    <%= form.label :image, "写真を変更する場合はファイルを選択" %><br>
    <%= form.file_field :image, accept: 'image/jpg,image/jpeg,image/png,image/gif' %>
  </div>
  <br>

  <div>
    <%= form.submit "更新する" %>
  </div>

<% end %>

<br>
<%= link_to "一覧に戻る", photos_path %>