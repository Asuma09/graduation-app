<div class="history-wrapper">
  
  <div style="max-width: 1150px; margin: 0 auto 30px; display: flex; justify-content: space-between; align-items: center;">
    <h1 style="margin: 0; font-size: 1.8em; color: #333; font-weight: bold;">フォトアルバム</h1>
    
    <div style="display: flex; gap: 15px; align-items: center;">
      <div style="font-size: 1.5em; color: #333; font-weight: bold; background: #fff; padding: 5px 20px; border-radius: 30px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">2025年前半</div>
    </div>
  </div>

  <div class="scrapbook-container">
    
    <a href="#" class="page-arrow arrow-prev">＜</a>
    <a href="#" class="page-arrow arrow-next">＞</a>

    <div style="text-align: right; margin-bottom: 25px;">
      <span class="btn-white" style="font-size: 0.85em; padding: 6px 20px; border-color: #eee;">並び替え</span>
    </div>

    <div class="scrapbook-grid">
      <% @photos.each_with_index do |post, index| %>
        <% 
          # 種類を判定（アスマさんの投稿内容に合わせて調整してください）
          type_label = (index % 2 == 0) ? "文章" : "思い出"
          card_size = index % 4 == 1 ? "card-tall" : (index % 4 == 3 ? "card-wide" : "")
        %>

        <div class="scrapbook-card <%= card_size %> card-type-<%= type_label %>">
          
          <div class="card-header-title">
            <span><%= type_label == "文章" ? "📄" : "✨" %></span>
            <%= type_label %>
          </div>

          <div style="flex-grow: 1;">
            <% if post.image.attached? %>
              <div style="width: 100%; height: 200px; background: #f4f2ec; overflow: hidden; border-radius: 10px; margin-bottom: 10px;">
                <%= image_tag post.image, style: "width: 100%; height: 100%; object-fit: cover;" %>
              </div>
            <% end %>
            <p style="margin: 0; font-size: 0.95em; color: #444; line-height: 1.8;">
              <%= post.content %>
            </p>
              
              <div style="margin-top: 10px;">
                <%= form_with url: create_comment_path(post), local: true do |form| %>
                  <%= form.text_field :content, placeholder: "返信...", class: "comment-input-small" %>
                  <%= form.submit "送信", class: "comment-submit-small" %>
                <% end %>
              </div>
            </div>
          </div>

          <div class="scrapbook-actions">
            <div style="display: flex; gap: 10px; align-items: center;">
              <% if post.liked_by?(current_user) %>
                <%= button_to "❤️ #{post.likes.count}", destroy_like_path(post), method: :delete, class: "like-button-style", style: "color: #ff6b6b; border: none;" %>
              <% else %>
                <%= button_to "🤍 #{post.likes.count}", create_like_path(post), method: :post, class: "like-button-style", style: "color: #999; border: none;" %>
              <% end %>

              <% if post.user == current_user %>
                <%= link_to "✏️", edit_photo_path(post), style: "font-size: 0.9em; text-decoration: none; color: #888; margin-left: 5px;" %>
                <%= button_to "🗑️", photo_path(post), method: :delete, form: { data: { turbo_confirm: "本当に削除しますか？" } }, style: "background: none; border: none; font-size: 0.9em; cursor: pointer; padding: 0;" %>
              <% end %>
            </div>
            
            <div style="text-align: right;">
              <small style="display: block; color: #bbb; margin-bottom: 2px;">by <%= post.user.nickname || "アスマ" %></small>
              <span class="item-date" style="font-size: 0.8em; color: #aaa;"><%= post.created_at.strftime("%Y年%m月") %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%= link_to posts_path, class: "btn-refresh", style: "border: 1px solid #eee;" do %>
      <span>↻</span> 更新
    <% end %>

    <div style="text-align: center; margin-top: 40px; color: #aaa; font-weight: bold; font-size: 0.9em;">
      (1) ページ
    </div>

  </div>
</div>