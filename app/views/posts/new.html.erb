<h1>新しい思い出を投稿する</h1>

<%# form_with というRailsの魔法を使って、入力フォームを作ります %>
<%= form_with model: @post, local: true do |form| %>
  
  <div>
    <%= form.label :event_date, "日付" %><br>
    <%= form.date_field :event_date %>
  </div>
  <br>

  <div>
    <%= form.label :content, "思い出の内容" %><br>
    <%= form.text_area :content, size: "40x5" %>
  </div>
  <br>

  <div>
    <%= form.submit "投稿する" %>
  </div>

<% end %>

<br>
<%= link_to "一覧に戻る", posts_path %>