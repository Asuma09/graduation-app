<div class="album-wrapper">
  
  <h2 style="text-align: center; margin-bottom: 20px; color: #333;">📝 思い出を編集する</h2>

  <div class="post-card" style="margin: 0 auto;">
    
    <%= form_with model: @post, local: true, html: { style: "display: flex; flex-direction: column; width: 100%; gap: 20px;" } do |form| %>
      
      <% if @post.errors.any? %>
        <div style="color: red; margin-bottom: 10px;">入力にエラーがあります</div>
      <% end %>

      <div class="auth-form-group">
        <%= form.label :content, "思い出の内容", class: "auth-label" %>
        <%= form.text_area :content, class: "auth-input", placeholder: "思い出を書き残しましょう...", rows: 5 %>
      </div>

      <div class="form-row">
        <div class="form-col">
          <%= form.label :event_date, "日付", class: "auth-label" %>
          <%= form.date_field :event_date, class: "auth-input" %>
        </div>
        <div class="form-col">
          <label class="auth-label">投稿者</label>
          <div class="auth-input" style="background: #eee; color: #888;">
             <%= current_user.nickname || "アスマ" %>
          </div>
        </div>
      </div>

      <div class="form-actions" style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
        <%= link_to "キャンセル", posts_path, class: "btn-cancel" %>
        <%= form.submit "更新する", class: "btn-submit" %>
      </div>

    <% end %>

  </div>
</div>
