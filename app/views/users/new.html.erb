<div class="auth-wrapper">
  <div class="auth-card">
    
    <div class="auth-left">
      <%= image_tag "welcome_illustration.jpg", class: "auth-illustration" %>
      <h3 style="color: #555;">コミュニティへようこそ</h3>
    </div>

    <div class="auth-right">
      
      <div class="auth-toggle-container">
        <div class="auth-toggle">
          <%= link_to "新規登録", signup_path, class: "active" %>
          <%= link_to "ログイン", login_path %>
        </div>
      </div>

     <%= form_with model: @user, url: signup_path, local: true do |f| %>
        
        <div class="auth-form-group">
          <%= f.label :nickname, "表示名（ニックネーム）", class: "auth-label" %>
          <%= f.text_field :nickname, class: "auth-input", placeholder: "ニックネームを入力" %>
        </div>

        <div class="auth-form-group">
          <%= f.label :email, "ユーザーID / メールアドレス", class: "auth-label" %>
          <%= f.email_field :email, class: "auth-input", placeholder: "IDを入力" %>
        </div>

        <div style="display: flex; gap: 10px;">
          <div class="auth-form-group" style="flex: 1;">
            <%= f.label :password, "パスワード", class: "auth-label" %>
            <%= f.password_field :password, class: "auth-input" %>
          </div>
          <div class="auth-form-group" style="flex: 1;">
            <%= f.label :password_confirmation, "パスワード（確認）", class: "auth-label" %>
            <%= f.password_field :password_confirmation, class: "auth-input" %>
          </div>
        </div>

        <%= f.submit "新規登録", class: "auth-submit-btn" %>
      <% end %>

    </div>
  </div>
</div>